# Copy to .env and fill these values.
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret

# FruitForge owner (the only account with full moderator/owner controls)
# Google login: put the exact Google email used for FruitForge here.
ADMIN_EMAIL=
# Roblox login: put the Roblox OAuth subject/user id here if you want Roblox login to be the owner too.
ADMIN_ROBLOX_ID=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Roblox OAuth 2.0 / OIDC
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
ROBLOX_REDIRECT_URI=http://localhost:3000/auth/roblox/callback

# Optional: set true after configuring HTTPS in production
COOKIE_SECURE=false
